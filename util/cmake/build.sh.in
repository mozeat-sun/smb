#!/bin/bash
################################################################################
# ZOO Utility Module Build Script
# Generated by CMake - DO NOT EDIT MANUALLY
################################################################################

set -e

BUILD_DIR="@CMAKE_CURRENT_SOURCE_DIR@/build"
SOURCE_DIR="@CMAKE_CURRENT_SOURCE_DIR@"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Building ZOO Utility Module${NC}"

# Clean old build directory
if [ -d "$BUILD_DIR" ]; then
    echo -e "${YELLOW}Cleaning old build directory...${NC}"
    rm -rf "$BUILD_DIR"
fi

# Create build directory
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

# Configure
echo -e "${YELLOW}Configuring build...${NC}"
cmake "$SOURCE_DIR" \
    -DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@ \
    -DBUILD_TESTS=OFF

# Build
echo -e "${YELLOW}Building...${NC}"
make -j$(nproc)

echo -e "${GREEN}Build completed successfully!${NC}"
