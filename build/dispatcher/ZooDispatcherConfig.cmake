# ZooDispatcher Configuration Template
# Auto-generated by CMake
get_filename_component(ZooDispatcher_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

# Include targets file
include("${ZooDispatcher_CMAKE_DIR}/ZooDispatcherTargets.cmake")

# Set library variables
set(ZooDispatcher_LIBRARIES zoo_dispatcher)
set(ZooDispatcher_INCLUDE_DIRS "/usr/local/include")

# Dependencies
find_dependency(Threads REQUIRED)

# Imported targets
if(NOT TARGET zoo::dispatcher)
    add_library(zoo::dispatcher ALIAS zoo_dispatcher)
endif()

# Version information
set(ZooDispatcher_VERSION "1.0.0")
set(ZooDispatcher_VERSION_MAJOR "1")
set(ZooDispatcher_VERSION_MINOR "0")
set(ZooDispatcher_VERSION_PATCH "0")

# Feature detection
set(ZooDispatcher_FEATURES)
list(APPEND ZooDispatcher_FEATURES "threading")
list(APPEND ZooDispatcher_FEATURES "message_queue")
list(APPEND ZooDispatcher_FEATURES "priority_sorting")

# Check if all required components are found
set(ZooDispatcher_FOUND TRUE)

# Component check function
macro(check_required_components _NAME)
    foreach(comp ${${_NAME}_FIND_COMPONENTS})
        if(NOT ${_NAME}_${comp}_FOUND)
            if(${_NAME}_FIND_REQUIRED_${comp})
                set(${_NAME}_FOUND FALSE)
            endif()
        endif()
    endforeach()
endmacro()

check_required_components(ZooDispatcher)
