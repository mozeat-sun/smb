src/**/rules.ninja
src/**/.ninja_deps
src/**/.ninja_log
src/**/CTestTestfile.cmake
src/**/CMakeCache.txt
src/**/compile_commands.json

# Logs and temporary files
*.log
*.tmp

# Environment and editor files
.env
*.swp
.vscode/

# OS-specific files
.DS_Store
