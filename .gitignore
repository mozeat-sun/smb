.ninja_log

# Ignore Makefile and CMake/cmake process files in src and all subdirectories
src/**/Makefile
src/**/Makefile.*
src/**/cmake_install.cmake*
src/**/CMakeFiles/
src/**/CMakeScripts/
src/**/CMakeTmp/
