# ==============================================================================
# ZOO Thread Pool - Multi-stage Docker Build
# Optimized for production deployment
# ==============================================================================

# Build stage
FROM ubuntu:22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy source code
COPY . /build/

# Configure and build
RUN mkdir -p build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DZOO_BUILD_STATIC=ON \
        -DZOO_BUILD_SHARED=OFF \
        -DZOO_ENABLE_TESTS=OFF \
        -DZOO_THREAD_POOL_DEBUG=OFF && \
    make -j$(nproc) && \
    make install DESTDIR=/install

# Runtime stage
FROM ubuntu:22.04 AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r zoo && useradd -r -g zoo zoo

# Copy installed files from builder
COPY --from=builder /install /

# Set up runtime environment
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
ENV PATH=/usr/local/bin:$PATH

# Switch to non-root user
USER zoo

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /usr/local/bin/zoo_thread_pool_tests --gtest_filter="*Basic*" || exit 1

# Default command
CMD ["/bin/bash"]

# Metadata
LABEL maintainer="@ZOO_THREAD_POOL_CONTACT@" \
      version="@ZOO_THREAD_POOL_VERSION@" \
      description="@ZOO_THREAD_POOL_DESCRIPTION@" \
      org.opencontainers.image.title="ZOO Thread Pool" \
      org.opencontainers.image.description="@ZOO_THREAD_POOL_DESCRIPTION@" \
      org.opencontainers.image.version="@ZOO_THREAD_POOL_VERSION@" \
      org.opencontainers.image.vendor="Basic Software Research Institute ltd" \
      org.opencontainers.image.licenses="MIT"
