{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZOO Quality Baselines",
  "type": "object",
  "required": [
    "schema_version",
    "owner",
    "updated_at_utc",
    "benchmark_profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "updated_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "benchmark_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "p99_latency_ms_max",
          "throughput_ops_min",
          "jitter_ms_max"
        ],
        "properties": {
          "p99_latency_ms_max": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "throughput_ops_min": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "jitter_ms_max": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "message_size_throughput_ops_min": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}